        },
        {
          "param": "after",
          "why": "Cursor pagination restarts from the beginning."
        },
        {
          "param": "token",
          "why": "The link is dead. Password resets, magic links and email confirmations are usually single-use, so retrying does not recover it."
        },
        {
          "param": "code",
          "why": "OAuth 2.0 authorization response (RFC 6749 §4.1.2). The token exchange never happens and login loops back to the start."
        },
        {
          "param": "state",
