  "phishing_shape": {
    "status": 200,
    "body": {
      "input": "https://login.bank.example@exämple.net/verify?session=a+b",
      "canonical": "https://login.bank.example@xn--exmple-cua.net/verify?session=a+b",
      "scheme": "https",
      "user": "login.bank.example",
      "host": "exämple.net",
      "host_ascii": "xn--exmple-cua.net",
      "host_unicode": "exämple.net",
      "path": "/verify",
      "segments": [
        {
          "index": 1,
          "raw": "verify",
          "decoded": "verify"
        }
      ],
      "params": [
        {
          "index": 1,
          "key": "session",
          "value": "a b",
          "raw_value": "a+b"
        }
      ],
      "linkable": true,
      "notes": [
        {
          "severity": "fail",
          "title": "Credentials before the host",
          "detail": "Everything before the @ is a username, not the destination. This URL goes to exämple.net."
        },
        {
          "severity": "warn",
          "title": "Internationalised domain name",
          "detail": "Displays as exämple.net; DNS looks it up as xn--exmple-cua.net. Check every letter before you trust it."
        },
        {
          "severity": "warn",
          "title": "Credentials in the query string",
          "detail": "session looks like a token or a session. A query string reaches the server and its logs, stays in browser history, and can leak to other sites in the Referer header: share this URL as you would a password."
        }
      ]
    }
  },
