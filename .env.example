# Copy to .env (gitignored; vars in docs/ARCHITECTURE.md §6). Prod layers a gitignored .env.prod
# holding only overrides (APP_ENV=prod, BASE_DOMAIN=corpberry.com); never restate values in compose.

# dev = read templates/static from disk + re-parse per request; prod = embedded
APP_ENV=dev

# Container binds 0.0.0.0; compose decides what the host exposes.
LISTEN_ADDR=:8080

# Virtual-host key suffix: "localhost" in dev, "corpberry.com" in prod.
BASE_DOMAIN=localhost

# Repo-relative so the same paths resolve in the container, where assets/ is bind-mounted.
IP2LOCATION_DB11_V4=tools/iptools/assets/ipv4/IP2LOCATION-LITE-DB11.BIN
IP2LOCATION_DB11_V6=tools/iptools/assets/ipv6/IP2LOCATION-LITE-DB11.IPV6.BIN
IP2LOCATION_ASN_V4=tools/iptools/assets/asn/IP2LOCATION-LITE-ASN.BIN
IP2LOCATION_ASN_V6=tools/iptools/assets/asn/IP2LOCATION-LITE-ASN.IPV6.BIN

# Optional: omit to hide the proxy/VPN section.
IP2PROXY_PX12=tools/iptools/assets/ip2proxy/IP2PROXY-LITE-PX12.BIN

# Read only by `make assets`, never by the app.
IP2LOCATION_DOWNLOAD_TOKEN=

# Path segment is the AUTH db (/admin), not the app db. Empty turns every Mongo feature off.
MONGODB_URI=mongodb://user:password@localhost/admin
# Defaults to "site-of-tools".
MONGODB_DATABASE=site-of-tools

# Short-link create key. Fail-closed: empty disables creation and the admin console, never opens
# them, because an open shortener becomes a phishing relay and gets all of corpberry.com blocklisted.
# Generate one with:  openssl rand -base64 32
LINK_API_KEY=

# Key for /mcp/owner (X-Api-Key or Bearer); fail-closed like LINK_API_KEY, empty means 404.
MCP_OWNER_KEY=

# Host's public IPs/CIDRs, comma-separated: outbound fetches refuse them; the container can't see them.
EGRESS_DENY_ADDRS=
