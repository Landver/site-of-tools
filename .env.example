# Copy to .env and fill in. .env is gitignored.
# See docs/ARCHITECTURE.md §6 for what each var does.
#
# .env holds the base (dev) values and is also loaded by the container. For prod,
# docker-compose layers a .env.prod on top of .env with just the overrides:
#     APP_ENV=prod
#     BASE_DOMAIN=corpberry.com
# .env.prod is gitignored (per-host, like .env) — create it on deploy. Keep all
# values in the env files; do not restate them in docker-compose.yml.

# dev = read templates/static from disk + re-parse per request; prod = embedded
APP_ENV=dev

# Bind address inside the process (container binds 0.0.0.0; compose publishes to host loopback)
LISTEN_ADDR=:8080

# Builds virtual-host keys. Use "localhost" in dev, "corpberry.com" in prod.
BASE_DOMAIN=localhost

# IP2Location LITE database paths (gitignored data; bind-mounted in prod as /assets)
IP2LOCATION_DB11_V4=tools/iptools/assets/ipv4/IP2LOCATION-LITE-DB11.BIN
IP2LOCATION_DB11_V6=tools/iptools/assets/ipv6/IP2LOCATION-LITE-DB11.IPV6.BIN
IP2LOCATION_ASN_V4=tools/iptools/assets/asn/IP2LOCATION-LITE-ASN.BIN
IP2LOCATION_ASN_V6=tools/iptools/assets/asn/IP2LOCATION-LITE-ASN.IPV6.BIN

# IP2Proxy PX12 (proxy/VPN/threat). Optional — omit to disable the proxy section.
IP2PROXY_PX12=tools/iptools/assets/ip2proxy/IP2PROXY-LITE-PX12.BIN

# Used only by `make assets` to download the BINs — NOT read by the app.
IP2LOCATION_DOWNLOAD_TOKEN=

# MongoDB — the shared server (localhost). The path segment is the
# AUTH database (/admin); the APP database is MONGODB_DATABASE below. Unlike the
# IP2Location BINs this is a network dependency, not a bind-mounted file, so the
# same URI works from dev and prod (add it to each host's .env). Optional: an
# empty MONGODB_URI disables Mongo — the client returns ErrMongoUnavailable and
# callers degrade gracefully. Four consumers: the IP-tool lookup history, the
# engine-level request log, botcheck's fingerprint corpus, and Link Tools' short
# links; empty simply turns all four off (see docs/ARCHITECTURE.md §10).
MONGODB_URI=mongodb://user:password@localhost/admin
# App database name. Defaults to "site-of-tools" if unset.
MONGODB_DATABASE=site-of-tools

# Link Tools short-link API key (link.corpberry.com). Creating a short link
# requires it; resolving one never does, so existing links keep working either way.
#
# FAIL-CLOSED, deliberately: an EMPTY value disables creation and the admin
# console entirely, it does not open them. An open URL shortener becomes a
# phishing relay within days, and the blocklisting that follows takes the whole
# corpberry.com domain with it, not just the offending link — so "unset" has to
# mean "nobody can create", never "anybody can".
# Generate one with:  openssl rand -base64 32
# See tools/linktools/docs/04-short-links.md §5.
LINK_API_KEY=
